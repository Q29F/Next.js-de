{
  "name": "idmhysi-fusion-workbench",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:http && npm run test:browser",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:http": "node --test scripts/smoke.mjs",
    "test:browser": "node --test scripts/browser.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
